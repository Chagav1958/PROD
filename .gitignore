# Ignore everything at root by default
/*

# Python cache and virtual environments (anywhere)
__pycache__/
*.pyc
*.pyo
.pytest_cache/
*.egg-info/

# Virtual environments
.venv/
venv/
env/

# Large binary files
*.bin

# Junk files
*.tmp
*.temp
*.log
vssver2.scc
Thumbs.db
.DS_Store
desktop.ini

# Allow specific file extensions at root only
!/*.ps1
!/*.md
!/*.jsonc
!/*.json
!/*.bat
!/*.py

# Allow specific directories (all contents within)
!/.opencode/
!/.config/
!/bin/
!/config/
!/docs/
!/models/
!/rules/
!/scripts/
!/tools/

# Exclude node_modules inside .opencode or anywhere else
**/node_modules/

# .config junction - exclude backup files at any depth
.config/**/*.bak*

# --- ОБЯЗАТЕЛЬНАЯ ЗАЩИТА: секреты НИКОГДА не в Git/GitHub ---
# Логины, пароли, токены, API-ключи, secrets — строго в config/.local_secrets.json
config/.local_secrets.json

# Шаблон структуры хранилища секретов — ДОПУСКАЕТСА в git (только пустые placeholder-значения)
# (игнорируется через *.local_secrets* ниже, но затем разрешается через !config/.local_secrets.example.json)

# Файлы конфигурации с зашифрованными паролями/токенами — ИСКЛЮЧЕНЫ из git
config/config.json
config/settings_history.json
config/oc-config-manager.json

# Базы знаний и объектов НЕ коммитить в Git (могут содержать вложения/ссылки)
*.db

# Секреты в любой конфигурации — ИСКЛЮЧЕНЫ: *.local_secrets*
*.local_secrets*
# Шаблон хранилища секретов — ИСКЛЮЧЕНИЕ: разрешить в git (только пустые значения)
!config/.local_secrets.example.json

# Токен atlassian (для MCP) — ИСКЛЮЧЕН из git; берётся через подстановку {file:config/atlassian_token.txt}
config/atlassian_token.txt

# Пароль Confluence (Basic auth для MCP atlassian) — ИСКЛЮЧЕН из git; подстановка {file:config/confluence_password.txt}
config/confluence_password.txt

# --- .config — это junction внутрь репозитория; всё, что содержит секреты, обязано быть исключено ---
# Секреты глобального конфига OpenCode (подстановки {file:secrets/...})
.config/opencode/secrets/
# Учётные данные EWS MCP (значения паролей/логинов) — никогда в git
.config/ews-mcp/credentials.env

# --- Артефакты сборки и runtime-состояние (18.09.2026) ---
# Отладочные символы .NET
*.pdb
# Манифесты зависимостей .NET
*.deps.json
# Состояние плагина PB/SQL-enforcer и логи сессий (динамические, меняются постоянно)
.opencode/session/pb-sql-enforcer.json
.opencode/session/errors.count
.opencode/session/edits.log
.opencode/session/searches.log

# Каталоги сборки C#-проектов (bin/obj) и runtime-настройки PB-сервиса
scripts/**/bin/
scripts/**/obj/
config/pb_service.json
