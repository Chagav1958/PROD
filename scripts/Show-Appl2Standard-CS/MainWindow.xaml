<Window x:Class="ShowAppl2Standard.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="APPL2 Стандарт" Height="580" Width="520"
        WindowStartupLocation="CenterScreen"
        Topmost="True"
        ResizeMode="CanResizeWithGrip"
        Background="#E8ECF0"
        AllowsTransparency="True"
        WindowStyle="None"
        Loaded="Window_Loaded"
        SizeChanged="Window_SizeChanged">
    <Window.Resources>
        <!--
            3D Glossy Element Template
            - Slightly oval (CornerRadius=10)
            - Dark border + 3-stop gradient + white gloss highlight
        -->
        <Style x:Key="GlossyBorder" TargetType="Border">
            <Setter Property="CornerRadius" Value="10"/>
        </Style>

        <!-- Standard button: blue 3D -->
        <Style TargetType="Button" x:Key="Glossy3DButton">
            <Setter Property="Width" Value="120"/>
            <Setter Property="Height" Value="38"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Margin" Value="4,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <Border CornerRadius="10" Background="#CC0F3050">
                                <Grid>
                                    <Border CornerRadius="9" Margin="1.5">
                                        <Border.Background>
                                            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                                <GradientStop Color="#CC9DC8F0" Offset="0"/>
                                                <GradientStop Color="#CC3B7BBF" Offset="0.5"/>
                                                <GradientStop Color="#CC1A4A7A" Offset="1"/>
                                            </LinearGradientBrush>
                                        </Border.Background>
                                    </Border>
                                    <Border CornerRadius="9" Margin="2,2,2,20" Height="7" VerticalAlignment="Top">
                                        <Border.Background>
                                            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                                <GradientStop Color="#E0FFFFFF" Offset="0"/>
                                                <GradientStop Color="#00FFFFFF" Offset="1"/>
                                            </LinearGradientBrush>
                                        </Border.Background>
                                    </Border>
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                                       Margin="0,2,0,0" TextBlock.FontWeight="Bold"
                                                       TextBlock.FontSize="11"/>
                                </Grid>
                            </Border>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Cancel: gray 3D, semi-transparent -->
        <Style TargetType="Button" x:Key="Glossy3DButtonCancel" BasedOn="{StaticResource Glossy3DButton}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <Border CornerRadius="10" Background="#CC404040">
                                <Grid>
                                    <Border CornerRadius="9" Margin="1.5">
                                        <Border.Background>
                                            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                                <GradientStop Color="#CCD0D0D0" Offset="0"/>
                                                <GradientStop Color="#CC909090" Offset="0.5"/>
                                                <GradientStop Color="#CC606060" Offset="1"/>
                                            </LinearGradientBrush>
                                        </Border.Background>
                                    </Border>
                                    <Border CornerRadius="9" Margin="2,2,2,20" Height="7" VerticalAlignment="Top">
                                        <Border.Background>
                                            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                                <GradientStop Color="#E0FFFFFF" Offset="0"/>
                                                <GradientStop Color="#00FFFFFF" Offset="1"/>
                                            </LinearGradientBrush>
                                        </Border.Background>
                                    </Border>
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                                       Margin="0,2,0,0" TextBlock.FontWeight="Bold"
                                                       TextBlock.FontSize="11"/>
                                </Grid>
                            </Border>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Small button (▼/▲ search): blue 3D, smaller -->
        <Style TargetType="Button" x:Key="Glossy3DButtonSmall" BasedOn="{StaticResource Glossy3DButton}">
            <Setter Property="Width" Value="30"/>
            <Setter Property="Height" Value="26"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Margin" Value="2,0"/>
        </Style>

        <!-- ProgressBar: 3D glossy style, moderate oval -->
        <Style TargetType="ProgressBar" x:Key="GlossyProgress">
            <Setter Property="Height" Value="18"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ProgressBar">
                        <Grid>
                            <!-- Outer dark border, semi-transparent -->
                            <Border CornerRadius="4" Background="#CC0F3050" Padding="1.5">
                                <!-- Track background -->
                                <Border CornerRadius="3" Background="#E2E8F0">
                                    <Grid ClipToBounds="True">
                                        <!-- Indicator track – Grid fills width so indicator resizes properly -->
                                        <Grid x:Name="PART_Track">
                                            <Border x:Name="PART_Indicator" CornerRadius="3"
                                                    BorderBrush="#CC1A3A60" BorderThickness="0,0,1,0"
                                                    HorizontalAlignment="Left">
                                                <Border.Background>
                                                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                                        <GradientStop Color="#CCB8D8F8" Offset="0"/>
                                                        <GradientStop Color="#CC3B7BBF" Offset="0.4"/>
                                                        <GradientStop Color="#CC1A4A7A" Offset="0.8"/>
                                                        <GradientStop Color="#CC0F3050" Offset="1"/>
                                                    </LinearGradientBrush>
                                                </Border.Background>
                                            </Border>
                                        </Grid>
                                        <!-- White gloss on top -->
                                        <Border CornerRadius="3" Margin="1,1,1,9" Height="5" VerticalAlignment="Top">
                                            <Border.Background>
                                                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                                    <GradientStop Color="#C0FFFFFF" Offset="0"/>
                                                    <GradientStop Color="#00FFFFFF" Offset="1"/>
                                                </LinearGradientBrush>
                                            </Border.Background>
                                        </Border>
                                        <!-- Bottom shadow for 3D depth -->
                                        <Border CornerRadius="3" Margin="1,12,1,1" Height="3" VerticalAlignment="Bottom" IsHitTestVisible="False">
                                            <Border.Background>
                                                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                                    <GradientStop Color="#30000000" Offset="0"/>
                                                    <GradientStop Color="#80000000" Offset="1"/>
                                                </LinearGradientBrush>
                                            </Border.Background>
                                        </Border>
                                    </Grid>
                                </Border>
                            </Border>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <!-- Window: opaque, slightly dark (#E8ECF0); title bar semi-transparent -->
    <Border CornerRadius="18" Background="#E8ECF0" BorderBrush="#1A3A60" BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect Color="#404040" Direction="270" ShadowDepth="4" BlurRadius="10" Opacity="0.5"/>
        </Border.Effect>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="40"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Title bar: darker than window + semi-transparent (#80 = 50%, deep blue-gray) -->
            <Border Grid.Row="0" Background="#807080B0" CornerRadius="17,17,0,0"
                    BorderBrush="#1A3A60" BorderThickness="0,0,0,1"
                    MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <!--
                        3D title text:
                        - White elongated shadow (extended right and down)
                        - Dark blue front text on top
                    -->
                    <Grid Grid.Column="0" Margin="14,0,0,0" VerticalAlignment="Center"
                          MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                        <TextBlock Text="APPL2 Стандарт" Foreground="White" FontWeight="Bold"
                                   FontSize="14" FontFamily="Segoe UI" HorizontalAlignment="Left"
                                   VerticalAlignment="Center" Margin="3,2,0,0" Opacity="0.9"/>
                        <TextBlock Text="APPL2 Стандарт" Foreground="#1A3A60" FontWeight="Bold"
                                   FontSize="14" FontFamily="Segoe UI" HorizontalAlignment="Left"
                                   VerticalAlignment="Center"/>
                    </Grid>
                    <Button Grid.Column="1" Content="━" Click="BtnMinimize_Click" Width="40" Height="36"
                            Background="Transparent" Foreground="#1A3A60" BorderThickness="0"
                            FontSize="14" FontWeight="Bold" Cursor="Hand"/>
                    <Button Grid.Column="2" Content="☐" Click="BtnMaximize_Click" Width="40" Height="36"
                            Background="Transparent" Foreground="#1A3A60" BorderThickness="0"
                            FontSize="14" FontWeight="Bold" Cursor="Hand"/>
                    <Button Grid.Column="3" Content="✕" Click="BtnClose_Click" Width="40" Height="36"
                            Background="Transparent" Foreground="#1A3A60" BorderThickness="0"
                            FontSize="14" FontWeight="Bold" Cursor="Hand"/>
                </Grid>
            </Border>

            <!-- Content area -->
            <Grid Grid.Row="1" Margin="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Fields row -->
                <Grid Grid.Row="0" Margin="10,10,10,6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Margin="0,0,3,0">
                        <TextBlock Text="TextBox" FontSize="10" Foreground="#4A5568" Margin="3,0,0,1"/>
                        <Border BorderBrush="#CBD5E0" BorderThickness="1" CornerRadius="10" Padding="6,4">
                            <TextBox x:Name="txtField" BorderThickness="0" Background="Transparent" FontSize="11" Padding="0"/>
                        </Border>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Margin="3,0">
                        <TextBlock Text="PasswordBox" FontSize="10" Foreground="#4A5568" Margin="3,0,0,1"/>
                        <Border BorderBrush="#CBD5E0" BorderThickness="1" CornerRadius="10" Padding="6,4">
                            <PasswordBox x:Name="pwdField" BorderThickness="0" Background="Transparent" FontSize="11" Padding="0"/>
                        </Border>
                    </StackPanel>
                    <StackPanel Grid.Column="2" Margin="3,0,0,0">
                        <TextBlock Text="ComboBox" FontSize="10" Foreground="#4A5568" Margin="3,0,0,1"/>
                        <Border BorderBrush="#CBD5E0" BorderThickness="1" CornerRadius="10" Padding="6,4">
                            <ComboBox x:Name="cmbField" BorderThickness="0" Background="Transparent" FontSize="11">
                                <ComboBoxItem>Пункт 1</ComboBoxItem>
                                <ComboBoxItem>Пункт 2</ComboBoxItem>
                                <ComboBoxItem>Пункт 3</ComboBoxItem>
                            </ComboBox>
                        </Border>
                    </StackPanel>
                </Grid>

                <!-- Search panel -->
                <Grid Grid.Row="1" Margin="10,0,10,4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="60"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="lblMatch" Grid.Column="0" Text="0 - 0" VerticalAlignment="Center"
                               FontSize="11" Foreground="#4A5568"/>
                    <TextBox x:Name="txtSearch" Grid.Column="1" Height="26" FontSize="11"
                             VerticalAlignment="Center" KeyDown="TxtSearch_KeyDown"
                             TextChanged="TxtSearch_TextChanged" Margin="0,0,4,0"/>
                    <Button Grid.Column="2" Content="▼" Click="BtnSearchDown_Click"
                            Style="{StaticResource Glossy3DButtonSmall}"/>
                    <Button Grid.Column="3" Content="▲" Click="BtnSearchUp_Click"
                            Style="{StaticResource Glossy3DButtonSmall}" Margin="2,0,0,0"/>
                </Grid>

                <!-- DataGrid -->
                <DataGrid x:Name="dgData" Grid.Row="2" Margin="10,0,10,4" AutoGenerateColumns="False"
                          IsReadOnly="True" HeadersVisibility="Column" RowHeaderWidth="0"
                          AlternatingRowBackground="#F5F7FA" FontSize="11"
                          VerticalScrollBarVisibility="Visible" HorizontalScrollBarVisibility="Visible"
                          Background="Transparent" RowBackground="White"
                          BorderBrush="#CBD5E0" BorderThickness="1"
                          CanUserResizeRows="False" CanUserSortColumns="True"
                          GridLinesVisibility="None" SelectionMode="Single" SelectionUnit="FullRow"
                          ScrollViewer.CanContentScroll="True">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Объект" Binding="{Binding Name}" Width="180"/>
                        <DataGridTextColumn Header="Тип" Binding="{Binding Type}" Width="140"/>
                        <DataGridTextColumn Header="Статус" Binding="{Binding Status}" Width="100"/>
                        <DataGridTextColumn Header="Описание" Binding="{Binding Desc}" Width="280"/>
                    </DataGrid.Columns>
                </DataGrid>

                <!-- Progress bars: glossy 3D -->
                <StackPanel Grid.Row="3" Margin="10,6,10,0">
                    <Grid Margin="0,0,0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="120"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="lblPhase" Grid.Column="0" Text="Фаза: загрузка данных"
                                   FontSize="11" Foreground="#4A5568" VerticalAlignment="Center"/>
                        <ProgressBar x:Name="pbPhase" Grid.Column="1" Minimum="0" Maximum="100" Value="45"
                                     Style="{StaticResource GlossyProgress}" VerticalAlignment="Center"/>
                    </Grid>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="120"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="lblStep" Grid.Column="0" Text="Шаг: (3 - 10)"
                                   FontSize="11" Foreground="#4A5568" VerticalAlignment="Center"/>
                        <ProgressBar x:Name="pbStep" Grid.Column="1" Minimum="0" Maximum="100" Value="30"
                                     Style="{StaticResource GlossyProgress}" VerticalAlignment="Center"/>
                    </Grid>
                </StackPanel>

                <!-- Buttons -->
                <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,10,10">
                    <Button x:Name="btnOk" Content="OK" Click="BtnOk_Click"
                            Style="{StaticResource Glossy3DButton}" IsDefault="True"/>
                    <Button x:Name="btnCancel" Content="Отмена" Click="BtnCancel_Click"
                            Style="{StaticResource Glossy3DButtonCancel}"/>
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</Window>
