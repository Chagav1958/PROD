<Window x:Class="ShowRestoreFromBackup.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Восстановление файлов из бэкапов" Height="520" Width="700"
        WindowStartupLocation="CenterScreen"
        Topmost="True"
        ResizeMode="CanResizeWithGrip"
        Background="#E8ECF0"
        AllowsTransparency="True"
        WindowStyle="None"
        Loaded="Window_Loaded"
        SizeChanged="Window_SizeChanged">
    <Window.Resources>
        <Style TargetType="Button" x:Key="Glossy3DButton">
            <Setter Property="Width" Value="160"/>
            <Setter Property="Height" Value="38"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Margin" Value="4,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <Border CornerRadius="10" Background="#CC0F3050">
                                <Grid>
                                    <Border CornerRadius="9" Margin="1.5">
                                        <Border.Background>
                                            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                                <GradientStop Color="#CC9DC8F0" Offset="0"/>
                                                <GradientStop Color="#CC3B7BBF" Offset="0.5"/>
                                                <GradientStop Color="#CC1A4A7A" Offset="1"/>
                                            </LinearGradientBrush>
                                        </Border.Background>
                                    </Border>
                                    <Border CornerRadius="9" Margin="2,2,2,20" Height="7" VerticalAlignment="Top">
                                        <Border.Background>
                                            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                                <GradientStop Color="#E0FFFFFF" Offset="0"/>
                                                <GradientStop Color="#00FFFFFF" Offset="1"/>
                                            </LinearGradientBrush>
                                        </Border.Background>
                                    </Border>
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                                       Margin="0,2,0,0" TextBlock.FontWeight="Bold"
                                                       TextBlock.FontSize="11"/>
                                </Grid>
                            </Border>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="Button" x:Key="Glossy3DButtonCancel" BasedOn="{StaticResource Glossy3DButton}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <Border CornerRadius="10" Background="#CC404040">
                                <Grid>
                                    <Border CornerRadius="9" Margin="1.5">
                                        <Border.Background>
                                            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                                <GradientStop Color="#CCD0D0D0" Offset="0"/>
                                                <GradientStop Color="#CC909090" Offset="0.5"/>
                                                <GradientStop Color="#CC606060" Offset="1"/>
                                            </LinearGradientBrush>
                                        </Border.Background>
                                    </Border>
                                    <Border CornerRadius="9" Margin="2,2,2,20" Height="7" VerticalAlignment="Top">
                                        <Border.Background>
                                            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                                <GradientStop Color="#E0FFFFFF" Offset="0"/>
                                                <GradientStop Color="#00FFFFFF" Offset="1"/>
                                            </LinearGradientBrush>
                                        </Border.Background>
                                    </Border>
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                                       Margin="0,2,0,0" TextBlock.FontWeight="Bold"
                                                       TextBlock.FontSize="11"/>
                                </Grid>
                            </Border>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="ProgressBar" x:Key="GlossyProgress">
            <Setter Property="Height" Value="18"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ProgressBar">
                        <Grid>
                            <Border CornerRadius="4" Background="#CC0F3050" Padding="1.5">
                                <Border CornerRadius="3" Background="#E2E8F0">
                                    <Grid ClipToBounds="True">
                                        <Grid x:Name="PART_Track">
                                            <Border x:Name="PART_Indicator" CornerRadius="3"
                                                    BorderBrush="#CC1A3A60" BorderThickness="0,0,1,0"
                                                    HorizontalAlignment="Left">
                                                <Border.Background>
                                                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                                        <GradientStop Color="#CCB8D8F8" Offset="0"/>
                                                        <GradientStop Color="#CC3B7BBF" Offset="0.4"/>
                                                        <GradientStop Color="#CC1A4A7A" Offset="0.8"/>
                                                        <GradientStop Color="#CC0F3050" Offset="1"/>
                                                    </LinearGradientBrush>
                                                </Border.Background>
                                            </Border>
                                        </Grid>
                                        <Border CornerRadius="3" Margin="1,1,1,9" Height="5" VerticalAlignment="Top">
                                            <Border.Background>
                                                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                                    <GradientStop Color="#C0FFFFFF" Offset="0"/>
                                                    <GradientStop Color="#00FFFFFF" Offset="1"/>
                                                </LinearGradientBrush>
                                            </Border.Background>
                                        </Border>
                                        <Border CornerRadius="3" Margin="1,12,1,1" Height="3" VerticalAlignment="Bottom" IsHitTestVisible="False">
                                            <Border.Background>
                                                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                                    <GradientStop Color="#30000000" Offset="0"/>
                                                    <GradientStop Color="#80000000" Offset="1"/>
                                                </LinearGradientBrush>
                                            </Border.Background>
                                        </Border>
                                    </Grid>
                                </Border>
                            </Border>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border CornerRadius="18" Background="#E8ECF0" BorderBrush="#1A3A60" BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect Color="#404040" Direction="270" ShadowDepth="4" BlurRadius="10" Opacity="0.5"/>
        </Border.Effect>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="40"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Background="#807080B0" CornerRadius="17,17,0,0"
                    BorderBrush="#1A3A60" BorderThickness="0,0,0,1"
                    MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Grid Grid.Column="0" Margin="14,0,0,0" VerticalAlignment="Center"
                          MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                        <TextBlock Text="Восстановление файлов из бэкапов" Foreground="White" FontWeight="Bold"
                                   FontSize="14" FontFamily="Segoe UI" HorizontalAlignment="Left"
                                   VerticalAlignment="Center" Margin="3,2,0,0" Opacity="0.9"/>
                        <TextBlock Text="Восстановление файлов из бэкапов" Foreground="#1A3A60" FontWeight="Bold"
                                   FontSize="14" FontFamily="Segoe UI" HorizontalAlignment="Left"
                                   VerticalAlignment="Center"/>
                    </Grid>
                    <Button Grid.Column="1" Content="━" Click="BtnMinimize_Click" Width="40" Height="36"
                            Background="Transparent" Foreground="#1A3A60" BorderThickness="0"
                            FontSize="14" FontWeight="Bold" Cursor="Hand"/>
                    <Button Grid.Column="2" Content="☐" Click="BtnMaximize_Click" Width="40" Height="36"
                            Background="Transparent" Foreground="#1A3A60" BorderThickness="0"
                            FontSize="14" FontWeight="Bold" Cursor="Hand"/>
                    <Button Grid.Column="3" Content="✕" Click="BtnClose_Click" Width="40" Height="36"
                            Background="Transparent" Foreground="#1A3A60" BorderThickness="0"
                            FontSize="14" FontWeight="Bold" Cursor="Hand"/>
                </Grid>
            </Border>

            <Grid Grid.Row="1" Margin="10,6,10,10">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Margin="0,0,0,4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="lblSummary" Grid.Column="0" Text="Всего: 0 | Отсутствует: 0 | Восстановлено: 0"
                               FontSize="11" Foreground="#4A5568" VerticalAlignment="Center" Margin="4,0,10,0"/>
                    <TextBox x:Name="txtSearch" Grid.Column="1" Height="24" FontSize="11"
                             VerticalAlignment="Center" TextChanged="TxtSearch_TextChanged" Margin="0,0,4,0"/>
                    <TextBlock Grid.Column="2" Text="Фильтр:" FontSize="10" Foreground="#4A5568"
                               VerticalAlignment="Center" Margin="0,0,4,0"/>
                </Grid>

                <DataGrid x:Name="dgFiles" Grid.Row="1" Margin="0,0,0,4" AutoGenerateColumns="False"
                          IsReadOnly="True" HeadersVisibility="Column" RowHeaderWidth="0"
                          AlternatingRowBackground="#F5F7FA" FontSize="11"
                          VerticalScrollBarVisibility="Visible" HorizontalScrollBarVisibility="Visible"
                          Background="Transparent" RowBackground="White"
                          BorderBrush="#CBD5E0" BorderThickness="1"
                          CanUserResizeRows="False" GridLinesVisibility="None"
                          SelectionMode="Extended" SelectionUnit="FullRow"
                          ScrollViewer.CanContentScroll="True">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Файл" Binding="{Binding RelativePath}" Width="280"/>
                        <DataGridTextColumn Header="Статус" Binding="{Binding Status}" Width="90"/>
                        <DataGridTextColumn Header="Источник" Binding="{Binding SourcePath}" Width="*"/>
                    </DataGrid.Columns>
                </DataGrid>

                <ProgressBar Grid.Row="2" x:Name="pbRestore" Minimum="0" Maximum="100" Value="0"
                             Style="{StaticResource GlossyProgress}" Margin="0,0,0,6"/>

                <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button x:Name="btnRestoreMissing" Content="Восстановить отсутствующие"
                            Click="BtnRestoreMissing_Click"
                            Style="{StaticResource Glossy3DButton}" IsDefault="True"/>
                    <Button x:Name="btnRestoreAll" Content="Восстановить все"
                            Click="BtnRestoreAll_Click"
                            Style="{StaticResource Glossy3DButton}" Margin="4,0"/>
                    <Button x:Name="btnCancel" Content="Закрыть" Click="BtnCancel_Click"
                            Style="{StaticResource Glossy3DButtonCancel}"/>
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</Window>
