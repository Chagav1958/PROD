<Window x:Class="Show_Abbreviations.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Сокращения AIS Release" Height="600" Width="900"
        WindowStartupLocation="CenterScreen" Topmost="True"
        ResizeMode="CanResizeWithGrip" Background="#E8ECF0"
        AllowsTransparency="True" WindowStyle="None"
        Loaded="Window_Loaded" SizeChanged="Window_SizeChanged">
    <Window.Resources>
        <Style TargetType="Button" x:Key="Glossy3DButtonSmall">
            <Setter Property="Width" Value="30"/><Setter Property="Height" Value="26"/>
            <Setter Property="FontWeight" Value="Bold"/><Setter Property="FontSize" Value="11"/>
            <Setter Property="Margin" Value="1,0"/><Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <Border CornerRadius="10" Background="#CC0F3050">
                                <Grid>
                                    <Border CornerRadius="9" Margin="1.5">
                                        <Border.Background>
                                            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                                <GradientStop Color="#CC9DC8F0" Offset="0"/>
                                                <GradientStop Color="#CC3B7BBF" Offset="0.5"/>
                                                <GradientStop Color="#CC1A4A7A" Offset="1"/>
                                            </LinearGradientBrush>
                                        </Border.Background>
                                    </Border>
                                    <Border CornerRadius="9" Margin="2,2,2,20" Height="5" VerticalAlignment="Top">
                                        <Border.Background>
                                            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                                <GradientStop Color="#E0FFFFFF" Offset="0"/>
                                                <GradientStop Color="#00FFFFFF" Offset="1"/>
                                            </LinearGradientBrush>
                                        </Border.Background>
                                    </Border>
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,1,0,0" TextBlock.FontWeight="Bold" TextBlock.FontSize="11"/>
                                </Grid>
                            </Border>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <Border CornerRadius="18" Background="#E8ECF0" BorderBrush="#1A3A60" BorderThickness="1">
        <Border.Effect><DropShadowEffect Color="#404040" Direction="270" ShadowDepth="4" BlurRadius="10" Opacity="0.5"/></Border.Effect>
        <Grid>
            <Grid.RowDefinitions><RowDefinition Height="40"/><RowDefinition Height="*"/></Grid.RowDefinitions>
            <Border Grid.Row="0" Background="#807080B0" CornerRadius="17,17,0,0" BorderBrush="#1A3A60" BorderThickness="0,0,0,1" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <Grid Grid.Column="0" Margin="14,0,0,0" VerticalAlignment="Center" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                        <TextBlock Text="Сокращения AIS Release" Foreground="White" FontWeight="Bold" FontSize="14" FontFamily="Segoe UI" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="3,2,0,0" Opacity="0.9"/>
                        <TextBlock Text="Сокращения AIS Release" Foreground="#1A3A60" FontWeight="Bold" FontSize="14" FontFamily="Segoe UI" HorizontalAlignment="Left" VerticalAlignment="Center"/>
                    </Grid>
                    <Button Grid.Column="1" Content="━" Click="BtnMinimize_Click" Width="40" Height="36" Background="Transparent" Foreground="#1A3A60" BorderThickness="0" FontSize="14" FontWeight="Bold" Cursor="Hand"/>
                    <Button Grid.Column="2" Content="☐" Click="BtnMaximize_Click" Width="40" Height="36" Background="Transparent" Foreground="#1A3A60" BorderThickness="0" FontSize="14" FontWeight="Bold" Cursor="Hand"/>
                    <Button Grid.Column="3" Content="✕" Click="BtnClose_Click" Width="40" Height="36" Background="Transparent" Foreground="#1A3A60" BorderThickness="0" FontSize="14" FontWeight="Bold" Cursor="Hand"/>
                </Grid>
            </Border>
            <Grid Grid.Row="1" Margin="10,6,10,10">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid Grid.Row="0" Margin="0,0,0,4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" x:Name="lblMatch" Text="0" FontSize="10" FontWeight="Bold" Foreground="#4A5568" VerticalAlignment="Center" Width="40" Margin="4,0"/>
                    <Border Grid.Column="1" CornerRadius="10" BorderBrush="#CBD5E0" BorderThickness="1" VerticalAlignment="Center">
                        <TextBox x:Name="txtSearch" Height="24" FontSize="10" BorderThickness="0" Padding="6,2" TextChanged="TxtSearch_TextChanged"/>
                    </Border>
                    <Button Grid.Column="2" x:Name="btnSearchDown" Content="▼" Click="BtnSearchDown_Click" Style="{StaticResource Glossy3DButtonSmall}" Margin="4,0,2,0"/>
                    <Button Grid.Column="3" x:Name="btnSearchUp" Content="▲" Click="BtnSearchUp_Click" Style="{StaticResource Glossy3DButtonSmall}"/>
                </Grid>
                <TabControl Grid.Row="1" x:Name="tabControl" Margin="0,0,0,4"/>
                <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button x:Name="btnClose" Content="Закрыть" Click="BtnClose_Click" Style="{StaticResource Glossy3DButtonSmall}" Width="100" Height="30"/>
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</Window>