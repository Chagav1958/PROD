<Window x:Class="Show_ProgressState.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="AIS Release — Выполнение задач" Height="280" Width="460"
        WindowStartupLocation="CenterScreen" Topmost="True"
        ResizeMode="CanResizeWithGrip" Background="#E8ECF0"
        AllowsTransparency="True" WindowStyle="None"
        Loaded="Window_Loaded" SizeChanged="Window_SizeChanged"
        Closing="Window_Closing">
    <Window.Resources>
        <Style TargetType="ProgressBar" x:Key="GlossyProgress">
            <Setter Property="Height" Value="18"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ProgressBar">
                        <Grid>
                            <Border CornerRadius="4" Background="#CC0F3050" Padding="1.5">
                                <Border CornerRadius="3" Background="#E2E8F0">
                                    <Grid ClipToBounds="True">
                                        <Grid x:Name="PART_Track">
                                            <Border x:Name="PART_Indicator" CornerRadius="3" BorderBrush="#CC1A3A60" BorderThickness="0,0,1,0" HorizontalAlignment="Left">
                                                <Border.Background>
                                                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                                        <GradientStop Color="#CCB8D8F8" Offset="0"/>
                                                        <GradientStop Color="#CC3B7BBF" Offset="0.4"/>
                                                        <GradientStop Color="#CC1A4A7A" Offset="0.8"/>
                                                        <GradientStop Color="#CC0F3050" Offset="1"/>
                                                    </LinearGradientBrush>
                                                </Border.Background>
                                            </Border>
                                        </Grid>
                                        <Border CornerRadius="3" Margin="1,1,1,9" Height="5" VerticalAlignment="Top">
                                            <Border.Background>
                                                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                                    <GradientStop Color="#C0FFFFFF" Offset="0"/>
                                                    <GradientStop Color="#00FFFFFF" Offset="1"/>
                                                </LinearGradientBrush>
                                            </Border.Background>
                                        </Border>
                                        <Border CornerRadius="3" Margin="1,12,1,1" Height="3" VerticalAlignment="Bottom" IsHitTestVisible="False">
                                            <Border.Background>
                                                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                                    <GradientStop Color="#30000000" Offset="0"/>
                                                    <GradientStop Color="#80000000" Offset="1"/>
                                                </LinearGradientBrush>
                                            </Border.Background>
                                        </Border>
                                    </Grid>
                                </Border>
                            </Border>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <Border CornerRadius="18" Background="#E8ECF0" BorderBrush="#1A3A60" BorderThickness="1">
        <Border.Effect><DropShadowEffect Color="#404040" Direction="270" ShadowDepth="4" BlurRadius="10" Opacity="0.5"/></Border.Effect>
        <Grid>
            <Grid.RowDefinitions><RowDefinition Height="40"/><RowDefinition Height="*"/></Grid.RowDefinitions>
            <Border Grid.Row="0" Background="#807080B0" CornerRadius="17,17,0,0" BorderBrush="#1A3A60" BorderThickness="0,0,0,1" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <Grid Grid.Column="0" Margin="14,0,0,0" VerticalAlignment="Center" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                        <TextBlock Text="AIS Release — Выполнение задач" Foreground="White" FontWeight="Bold" FontSize="14" FontFamily="Segoe UI" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="3,2,0,0" Opacity="0.9"/>
                        <TextBlock Text="AIS Release — Выполнение задач" Foreground="#1A3A60" FontWeight="Bold" FontSize="14" FontFamily="Segoe UI" HorizontalAlignment="Left" VerticalAlignment="Center"/>
                    </Grid>
                    <Button Grid.Column="1" Content="━" Click="BtnMinimize_Click" Width="40" Height="36" Background="Transparent" Foreground="#1A3A60" BorderThickness="0" FontSize="14" FontWeight="Bold" Cursor="Hand"/>
                    <Button Grid.Column="2" Content="☐" Click="BtnMaximize_Click" Width="40" Height="36" Background="Transparent" Foreground="#1A3A60" BorderThickness="0" FontSize="14" FontWeight="Bold" Cursor="Hand"/>
                    <Button Grid.Column="3" Content="✕" Click="BtnClose_Click" Width="40" Height="36" Background="Transparent" Foreground="#1A3A60" BorderThickness="0" FontSize="14" FontWeight="Bold" Cursor="Hand"/>
                </Grid>
            </Border>
            <Grid Grid.Row="1" Margin="10,6,10,10">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="0" Text="AIS Release — Выполнение задач" FontSize="10" FontWeight="Bold" Foreground="#1A3A60" VerticalAlignment="Center" Margin="4,0,0,6"/>
                <Grid Grid.Row="1" Margin="4,0,4,4">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="Общий:" FontSize="9" Foreground="#4A5568" VerticalAlignment="Center" Width="80"/>
                    <ProgressBar Grid.Column="1" x:Name="pbOverall" Style="{StaticResource GlossyProgress}" Height="18"/>
                </Grid>
                <TextBlock Grid.Row="2" x:Name="lblTask" Text="Задача: —" FontSize="9" Foreground="#4A5568" Margin="4,0,0,4"/>
                <Grid Grid.Row="3" Margin="4,0,4,4">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="Текущая:" FontSize="9" Foreground="#4A5568" VerticalAlignment="Center" Width="80"/>
                    <ProgressBar Grid.Column="1" x:Name="pbStep" Style="{StaticResource GlossyProgress}" Height="18"/>
                </Grid>
                <TextBlock Grid.Row="4" x:Name="lblStatus" Text="" FontSize="9" Foreground="#718096" Margin="4,0"/>
                <TextBlock Grid.Row="5" x:Name="lblTimestamp" Text="" FontSize="8" Foreground="#A0AEC0" Margin="4,2,0,0"/>
            </Grid>
        </Grid>
    </Border>
</Window>