<Window x:Class="ShowRestoreDialog.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Восстановление конфигов OpenCode" Height="480" Width="580"
        WindowStartupLocation="CenterScreen"
        Topmost="True"
        ResizeMode="CanResizeWithGrip"
        Background="#E8ECF0"
        AllowsTransparency="True"
        WindowStyle="None"
        Loaded="Window_Loaded"
        SizeChanged="Window_SizeChanged">
    <Window.Resources>
        <Style x:Key="GlossyBorder" TargetType="Border">
            <Setter Property="CornerRadius" Value="10"/>
        </Style>
        <Style TargetType="Button" x:Key="Glossy3DButton">
            <Setter Property="Width" Value="120"/>
            <Setter Property="Height" Value="38"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Margin" Value="4,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <Border CornerRadius="10" Background="#CC0F3050">
                                <Grid>
                                    <Border CornerRadius="9" Margin="1.5">
                                        <Border.Background>
                                            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                                <GradientStop Color="#CC9DC8F0" Offset="0"/>
                                                <GradientStop Color="#CC3B7BBF" Offset="0.5"/>
                                                <GradientStop Color="#CC1A4A7A" Offset="1"/>
                                            </LinearGradientBrush>
                                        </Border.Background>
                                    </Border>
                                    <Border CornerRadius="9" Margin="2,2,2,20" Height="7" VerticalAlignment="Top">
                                        <Border.Background>
                                            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                                <GradientStop Color="#E0FFFFFF" Offset="0"/>
                                                <GradientStop Color="#00FFFFFF" Offset="1"/>
                                            </LinearGradientBrush>
                                        </Border.Background>
                                    </Border>
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                                       Margin="0,2,0,0" TextBlock.FontWeight="Bold"
                                                       TextBlock.FontSize="11"/>
                                </Grid>
                            </Border>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="Button" x:Key="Glossy3DButtonCancel" BasedOn="{StaticResource Glossy3DButton}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <Border CornerRadius="10" Background="#CC404040">
                                <Grid>
                                    <Border CornerRadius="9" Margin="1.5">
                                        <Border.Background>
                                            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                                <GradientStop Color="#CCD0D0D0" Offset="0"/>
                                                <GradientStop Color="#CC909090" Offset="0.5"/>
                                                <GradientStop Color="#CC606060" Offset="1"/>
                                            </LinearGradientBrush>
                                        </Border.Background>
                                    </Border>
                                    <Border CornerRadius="9" Margin="2,2,2,20" Height="7" VerticalAlignment="Top">
                                        <Border.Background>
                                            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                                <GradientStop Color="#E0FFFFFF" Offset="0"/>
                                                <GradientStop Color="#00FFFFFF" Offset="1"/>
                                            </LinearGradientBrush>
                                        </Border.Background>
                                    </Border>
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                                       Margin="0,2,0,0" TextBlock.FontWeight="Bold"
                                                       TextBlock.FontSize="11"/>
                                </Grid>
                            </Border>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="ProgressBar" x:Key="GlossyProgress">
            <Setter Property="Height" Value="18"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ProgressBar">
                        <Grid>
                            <Border CornerRadius="4" Background="#CC0F3050" Padding="1.5">
                                <Border CornerRadius="3" Background="#E2E8F0">
                                    <Grid ClipToBounds="True">
                                        <Grid x:Name="PART_Track">
                                            <Border x:Name="PART_Indicator" CornerRadius="3"
                                                    BorderBrush="#CC1A3A60" BorderThickness="0,0,1,0"
                                                    HorizontalAlignment="Left">
                                                <Border.Background>
                                                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                                        <GradientStop Color="#CCB8D8F8" Offset="0"/>
                                                        <GradientStop Color="#CC3B7BBF" Offset="0.4"/>
                                                        <GradientStop Color="#CC1A4A7A" Offset="0.8"/>
                                                        <GradientStop Color="#CC0F3050" Offset="1"/>
                                                    </LinearGradientBrush>
                                                </Border.Background>
                                            </Border>
                                        </Grid>
                                        <Border CornerRadius="3" Margin="1,1,1,9" Height="5" VerticalAlignment="Top">
                                            <Border.Background>
                                                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                                    <GradientStop Color="#C0FFFFFF" Offset="0"/>
                                                    <GradientStop Color="#00FFFFFF" Offset="1"/>
                                                </LinearGradientBrush>
                                            </Border.Background>
                                        </Border>
                                        <Border CornerRadius="3" Margin="1,12,1,1" Height="3" VerticalAlignment="Bottom" IsHitTestVisible="False">
                                            <Border.Background>
                                                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                                    <GradientStop Color="#30000000" Offset="0"/>
                                                    <GradientStop Color="#80000000" Offset="1"/>
                                                </LinearGradientBrush>
                                            </Border.Background>
                                        </Border>
                                    </Grid>
                                </Border>
                            </Border>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border CornerRadius="18" Background="#E8ECF0" BorderBrush="#1A3A60" BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect Color="#404040" Direction="270" ShadowDepth="4" BlurRadius="10" Opacity="0.5"/>
        </Border.Effect>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="40"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Background="#807080B0" CornerRadius="17,17,0,0"
                    BorderBrush="#1A3A60" BorderThickness="0,0,0,1"
                    MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Grid Grid.Column="0" Margin="14,0,0,0" VerticalAlignment="Center"
                          MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                        <TextBlock Text="Восстановление конфигов OpenCode" Foreground="White" FontWeight="Bold"
                                   FontSize="14" FontFamily="Segoe UI" HorizontalAlignment="Left"
                                   VerticalAlignment="Center" Margin="3,2,0,0" Opacity="0.9"/>
                        <TextBlock Text="Восстановление конфигов OpenCode" Foreground="#1A3A60" FontWeight="Bold"
                                   FontSize="14" FontFamily="Segoe UI" HorizontalAlignment="Left"
                                   VerticalAlignment="Center"/>
                    </Grid>
                    <Button Grid.Column="1" Content="━" Click="BtnMinimize_Click" Width="40" Height="36"
                            Background="Transparent" Foreground="#1A3A60" BorderThickness="0"
                            FontSize="14" FontWeight="Bold" Cursor="Hand"/>
                    <Button Grid.Column="2" Content="☐" Click="BtnMaximize_Click" Width="40" Height="36"
                            Background="Transparent" Foreground="#1A3A60" BorderThickness="0"
                            FontSize="14" FontWeight="Bold" Cursor="Hand"/>
                    <Button Grid.Column="3" Content="✕" Click="BtnClose_Click" Width="40" Height="36"
                            Background="Transparent" Foreground="#1A3A60" BorderThickness="0"
                            FontSize="14" FontWeight="Bold" Cursor="Hand"/>
                </Grid>
            </Border>

            <Grid Grid.Row="1" Margin="12,10,12,10">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Text="Выберите снапшот для восстановления:"
                           FontSize="11" FontWeight="Bold" Foreground="#4A5568" Margin="4,0,0,4"/>

                <Border Grid.Row="1" BorderBrush="#CBD5E0" BorderThickness="1" CornerRadius="4" Margin="0,0,0,6"
                        Padding="0">
                    <ListBox x:Name="lstSnapshots" FontSize="11" FontFamily="Consolas"
                             Background="White" BorderThickness="0"
                             SelectionChanged="LstSnapshots_SelectionChanged"/>
                </Border>

                <TextBlock Grid.Row="2" Text="Или введите дату вручную (YYYYMMDD_HHMMSS):"
                           FontSize="10" Foreground="#4A5568" Margin="4,0,0,2"/>

                <Border Grid.Row="3" BorderBrush="#CBD5E0" BorderThickness="1" CornerRadius="10" Padding="6,4"
                        Margin="0,0,0,6" Width="220" HorizontalAlignment="Left">
                    <TextBox x:Name="txtDate" FontSize="11" FontFamily="Consolas"
                             BorderThickness="0" Background="Transparent"
                             KeyDown="TxtDate_KeyDown"/>
                </Border>

                <TextBlock Grid.Row="4" x:Name="lblStatus" Text="" FontSize="10"
                           Foreground="#4A5568" Margin="4,0,0,4"/>

                <ProgressBar Grid.Row="5" x:Name="pbRestore" Minimum="0" Maximum="100" Value="0"
                             Style="{StaticResource GlossyProgress}" Margin="0,0,0,6"/>

                <StackPanel Grid.Row="6" Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button x:Name="btnRestore" Content="Восстановить" Click="BtnRestore_Click"
                            Style="{StaticResource Glossy3DButton}" IsDefault="True"/>
                    <Button x:Name="btnCancel" Content="Отмена" Click="BtnCancel_Click"
                            Style="{StaticResource Glossy3DButtonCancel}"/>
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</Window>
