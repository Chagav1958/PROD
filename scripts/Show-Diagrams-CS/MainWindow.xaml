<Window x:Class="Show_Diagrams.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ДИАГРАММЫ AIS" Height="720" Width="1100"
        WindowStartupLocation="CenterScreen" Topmost="True"
        ResizeMode="CanResizeWithGrip" Background="#E8ECF0"
        AllowsTransparency="True" WindowStyle="None"
        Loaded="Window_Loaded" SizeChanged="Window_SizeChanged">
    <Window.Resources>
        <Style TargetType="Button" x:Key="Glossy3DButton">
            <Setter Property="Width" Value="140"/><Setter Property="Height" Value="38"/>
            <Setter Property="FontWeight" Value="Bold"/><Setter Property="FontSize" Value="11"/>
            <Setter Property="Margin" Value="4,0"/><Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Template">
                <Setter.Value><ControlTemplate TargetType="Button"><Grid><Border CornerRadius="10" Background="#CC0F3050"><Grid><Border CornerRadius="9" Margin="1.5"><Border.Background><LinearGradientBrush StartPoint="0,0" EndPoint="0,1"><GradientStop Color="#CC9DC8F0" Offset="0"/><GradientStop Color="#CC3B7BBF" Offset="0.5"/><GradientStop Color="#CC1A4A7A" Offset="1"/></LinearGradientBrush></Border.Background></Border><Border CornerRadius="9" Margin="2,2,2,20" Height="7" VerticalAlignment="Top"><Border.Background><LinearGradientBrush StartPoint="0,0" EndPoint="0,1"><GradientStop Color="#E0FFFFFF" Offset="0"/><GradientStop Color="#00FFFFFF" Offset="1"/></LinearGradientBrush></Border.Background></Border><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,2,0,0" TextBlock.FontWeight="Bold" TextBlock.FontSize="11"/></Grid></Border></Grid></ControlTemplate></Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="Button" x:Key="Glossy3DButtonCancel" BasedOn="{StaticResource Glossy3DButton}">
            <Setter Property="Template">
                <Setter.Value><ControlTemplate TargetType="Button"><Grid><Border CornerRadius="10" Background="#CC404040"><Grid><Border CornerRadius="9" Margin="1.5"><Border.Background><LinearGradientBrush StartPoint="0,0" EndPoint="0,1"><GradientStop Color="#CCD0D0D0" Offset="0"/><GradientStop Color="#CC909090" Offset="0.5"/><GradientStop Color="#CC606060" Offset="1"/></LinearGradientBrush></Border.Background></Border><Border CornerRadius="9" Margin="2,2,2,20" Height="7" VerticalAlignment="Top"><Border.Background><LinearGradientBrush StartPoint="0,0" EndPoint="0,1"><GradientStop Color="#E0FFFFFF" Offset="0"/><GradientStop Color="#00FFFFFF" Offset="1"/></LinearGradientBrush></Border.Background></Border><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,2,0,0" TextBlock.FontWeight="Bold" TextBlock.FontSize="11"/></Grid></Border></Grid></ControlTemplate></Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="Button" x:Key="Glossy3DButtonSmall">
            <Setter Property="Width" Value="30"/><Setter Property="Height" Value="26"/>
            <Setter Property="FontWeight" Value="Bold"/><Setter Property="FontSize" Value="11"/>
            <Setter Property="Margin" Value="2,0"/><Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Template">
                <Setter.Value><ControlTemplate TargetType="Button"><Grid><Border CornerRadius="10" Background="#CC0F3050"><Grid><Border CornerRadius="9" Margin="1.5"><Border.Background><LinearGradientBrush StartPoint="0,0" EndPoint="0,1"><GradientStop Color="#CC9DC8F0" Offset="0"/><GradientStop Color="#CC3B7BBF" Offset="0.5"/><GradientStop Color="#CC1A4A7A" Offset="1"/></LinearGradientBrush></Border.Background></Border><Border CornerRadius="9" Margin="2,2,2,14" Height="5" VerticalAlignment="Top"><Border.Background><LinearGradientBrush StartPoint="0,0" EndPoint="0,1"><GradientStop Color="#E0FFFFFF" Offset="0"/><GradientStop Color="#00FFFFFF" Offset="1"/></LinearGradientBrush></Border.Background></Border><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,1,0,0" TextBlock.FontWeight="Bold" TextBlock.FontSize="11"/></Grid></Border></Grid></ControlTemplate></Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <Border CornerRadius="18" Background="#E8ECF0" BorderBrush="#1A3A60" BorderThickness="1">
        <Border.Effect><DropShadowEffect Color="#404040" Direction="270" ShadowDepth="4" BlurRadius="10" Opacity="0.5"/></Border.Effect>
        <Grid>
            <Grid.RowDefinitions><RowDefinition Height="40"/><RowDefinition Height="*"/></Grid.RowDefinitions>
            <Border Grid.Row="0" Background="#807080B0" CornerRadius="17,17,0,0" BorderBrush="#1A3A60" BorderThickness="0,0,0,1" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <Grid Grid.Column="0" Margin="14,0,0,0" VerticalAlignment="Center" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                        <TextBlock Text="ДИАГРАММЫ AIS — Визуализация проекта" Foreground="White" FontWeight="Bold" FontSize="14" FontFamily="Segoe UI" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="3,2,0,0" Opacity="0.9"/>
                        <TextBlock Text="ДИАГРАММЫ AIS — Визуализация проекта" Foreground="#1A3A60" FontWeight="Bold" FontSize="14" FontFamily="Segoe UI" HorizontalAlignment="Left" VerticalAlignment="Center"/>
                    </Grid>
                    <Button Grid.Column="1" Content="━" Click="BtnMinimize_Click" Width="40" Height="36" Background="Transparent" Foreground="#1A3A60" BorderThickness="0" FontSize="14" FontWeight="Bold" Cursor="Hand"/>
                    <Button Grid.Column="2" Content="☐" Click="BtnMaximize_Click" Width="40" Height="36" Background="Transparent" Foreground="#1A3A60" BorderThickness="0" FontSize="14" FontWeight="Bold" Cursor="Hand"/>
                    <Button Grid.Column="3" Content="✕" Click="BtnClose_Click" Width="40" Height="36" Background="Transparent" Foreground="#1A3A60" BorderThickness="0" FontSize="14" FontWeight="Bold" Cursor="Hand"/>
                </Grid>
            </Border>
            <Grid Grid.Row="1" Margin="10,6,10,10">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid Grid.Row="0" Margin="0,0,0,4">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="Поиск:" VerticalAlignment="Center" Margin="0,0,6,0" FontSize="10" Foreground="#4A5568"/>
                    <TextBox Grid.Column="1" x:Name="txtSearch" TextChanged="TxtSearch_TextChanged" FontSize="11" KeyDown="TxtSearch_KeyDown"/>
                    <Button Grid.Column="2" Content="▼" Click="BtnSearchDown_Click" Style="{StaticResource Glossy3DButtonSmall}"/>
                    <Button Grid.Column="3" Content="▲" Click="BtnSearchUp_Click" Style="{StaticResource Glossy3DButtonSmall}"/>
                </Grid>
                <TabControl Grid.Row="1" x:Name="tabControl" Margin="0,0,0,4"/>
                <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,4,0,0">
                    <Button x:Name="btnRefresh" Content="Обновить" Click="BtnRefresh_Click" Style="{StaticResource Glossy3DButton}" Width="120"/>
                    <Button x:Name="btnOpenFolder" Content="Открыть папку" Click="BtnOpenFolder_Click" Style="{StaticResource Glossy3DButton}" Width="140"/>
                    <Button x:Name="btnClose" Content="Закрыть" Click="BtnClose_Click" Style="{StaticResource Glossy3DButtonCancel}"/>
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</Window>
