<Window x:Class="SetupSecrets.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="НАСТРОЙКА СЕКРЕТОВ" Height="520" Width="680"
        WindowStartupLocation="CenterScreen" Topmost="True"
        ResizeMode="CanResizeWithGrip" Background="#E8ECF0"
        AllowsTransparency="True" WindowStyle="None"
        Loaded="Window_Loaded" SizeChanged="Window_SizeChanged"
        KeyDown="Window_KeyDown">
    <Border CornerRadius="18" Background="#E8ECF0" BorderBrush="#1A3A60" BorderThickness="1">
        <Border.Effect><DropShadowEffect Color="#404040" Direction="270" ShadowDepth="4" BlurRadius="10" Opacity="0.5"/></Border.Effect>
        <Grid>
            <Grid.RowDefinitions><RowDefinition Height="40"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <Border Grid.Row="0" Background="#807080B0" CornerRadius="17,17,0,0" BorderBrush="#1A3A60" BorderThickness="0,0,0,1">
                <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <Grid Grid.Column="0" Margin="14,0,0,0" VerticalAlignment="Center" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                        <TextBlock Text="НАСТРОЙКА СЕКРЕТОВ" Foreground="White" FontWeight="Bold" FontSize="14" Opacity="0.9"/>
                        <TextBlock Text="НАСТРОЙКА СЕКРЕТОВ" Foreground="#1A3A60" FontWeight="Bold" FontSize="14"/>
                    </Grid>
                    <Button Grid.Column="1" Content="━" Click="BtnMin_Click" Width="40" Height="36" Background="Transparent" Foreground="#1A3A60" BorderThickness="0" FontSize="14" FontWeight="Bold" Cursor="Hand"/>
                    <Button Grid.Column="2" Content="✕" Click="BtnClose_Click" Width="40" Height="36" Background="Transparent" Foreground="#1A3A60" BorderThickness="0" FontSize="14" FontWeight="Bold" Cursor="Hand"/>
                </Grid>
            </Border>
            <TabControl Grid.Row="1" Margin="10">
                <TabItem Header="Sybase">
                    <Grid Margin="10"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                        <Grid Grid.Row="0"><Grid.ColumnDefinitions><ColumnDefinition Width="100"/><ColumnDefinition Width="300"/></Grid.ColumnDefinitions>
                            <TextBlock Text="Пароль:" VerticalAlignment="Center" FontWeight="Bold"/>
                            <TextBox x:Name="tbSybasePass" Grid.Column="1" Margin="5"/>
                        </Grid>
                    </Grid>
                </TabItem>
                <TabItem Header="VSS">
                    <Grid Margin="10"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                        <Grid Grid.Row="0"><Grid.ColumnDefinitions><ColumnDefinition Width="100"/><ColumnDefinition Width="300"/></Grid.ColumnDefinitions>
                            <TextBlock Text="Логин:" VerticalAlignment="Center" FontWeight="Bold"/>
                            <TextBox x:Name="tbVssUser" Grid.Column="1" Margin="5"/>
                        </Grid>
                        <Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition Width="100"/><ColumnDefinition Width="300"/></Grid.ColumnDefinitions>
                            <TextBlock Text="Пароль:" VerticalAlignment="Center" FontWeight="Bold"/>
                            <TextBox x:Name="tbVssPass" Grid.Column="1" Margin="5"/>
                        </Grid>
                        <Grid Grid.Row="2"><Grid.ColumnDefinitions><ColumnDefinition Width="100"/><ColumnDefinition Width="300"/></Grid.ColumnDefinitions>
                            <TextBlock Text="Master Key:" VerticalAlignment="Center" FontWeight="Bold"/>
                            <TextBox x:Name="tbVssMaster" Grid.Column="1" Margin="5"/>
                        </Grid>
                    </Grid>
                </TabItem>
                <TabItem Header="Jira">
                    <Grid Margin="10"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                        <Grid Grid.Row="0"><Grid.ColumnDefinitions><ColumnDefinition Width="120"/><ColumnDefinition Width="300"/></Grid.ColumnDefinitions>
                            <TextBlock Text="API Token:" VerticalAlignment="Center" FontWeight="Bold"/>
                            <TextBox x:Name="tbJiraApi" Grid.Column="1" Margin="5"/>
                        </Grid>
                        <Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition Width="120"/><ColumnDefinition Width="300"/></Grid.ColumnDefinitions>
                            <TextBlock Text="Token:" VerticalAlignment="Center" FontWeight="Bold"/>
                            <TextBox x:Name="tbJiraToken" Grid.Column="1" Margin="5"/>
                        </Grid>
                    </Grid>
                </TabItem>
                <TabItem Header="OpenCode API">
                    <Grid Margin="10"><Grid.RowDefinitions><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                        <Grid Grid.Row="0"><Grid.ColumnDefinitions><ColumnDefinition Width="100"/><ColumnDefinition Width="300"/></Grid.ColumnDefinitions>
                            <TextBlock Text="Пароль:" VerticalAlignment="Center" FontWeight="Bold"/>
                            <TextBox x:Name="tbOcPass" Grid.Column="1" Margin="5"/>
                        </Grid>
                    </Grid>
                </TabItem>
                <TabItem Header="EWS (Exchange)">
                    <Grid Margin="10"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                        <Grid Grid.Row="0"><Grid.ColumnDefinitions><ColumnDefinition Width="120"/><ColumnDefinition Width="300"/></Grid.ColumnDefinitions>
                            <TextBlock Text="Сервер URL:" VerticalAlignment="Center" FontWeight="Bold"/>
                            <TextBox x:Name="tbEwsUrl" Grid.Column="1" Margin="5"/>
                        </Grid>
                        <Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition Width="120"/><ColumnDefinition Width="300"/></Grid.ColumnDefinitions>
                            <TextBlock Text="Email:" VerticalAlignment="Center" FontWeight="Bold"/>
                            <TextBox x:Name="tbEwsEmail" Grid.Column="1" Margin="5"/>
                        </Grid>
                        <Grid Grid.Row="2"><Grid.ColumnDefinitions><ColumnDefinition Width="120"/><ColumnDefinition Width="300"/></Grid.ColumnDefinitions>
                            <TextBlock Text="Логин (DOMAIN\\):" VerticalAlignment="Center" FontWeight="Bold"/>
                            <TextBox x:Name="tbEwsUser" Grid.Column="1" Margin="5"/>
                        </Grid>
                        <Grid Grid.Row="3"><Grid.ColumnDefinitions><ColumnDefinition Width="120"/><ColumnDefinition Width="300"/></Grid.ColumnDefinitions>
                            <TextBlock Text="Пароль:" VerticalAlignment="Center" FontWeight="Bold"/>
                            <TextBox x:Name="tbEwsPass" Grid.Column="1" Margin="5"/>
                        </Grid>
                    </Grid>
                </TabItem>
                <TabItem Header="OpenCode / MCP (вне Git)">
                    <Grid Margin="10">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid Grid.Row="0"><Grid.ColumnDefinitions><ColumnDefinition Width="140"/><ColumnDefinition Width="320"/></Grid.ColumnDefinitions>
                            <TextBlock Text="Jira PAT-токен:" VerticalAlignment="Center" FontWeight="Bold"/>
                            <TextBox x:Name="tbOcJiraToken" Grid.Column="1" Margin="5"/>
                        </Grid>
                        <Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition Width="140"/><ColumnDefinition Width="320"/></Grid.ColumnDefinitions>
                            <TextBlock Text="Confluence пароль:" VerticalAlignment="Center" FontWeight="Bold"/>
                            <TextBox x:Name="tbOcConfPass" Grid.Column="1" Margin="5"/>
                        </Grid>
                        <Grid Grid.Row="2"><Grid.ColumnDefinitions><ColumnDefinition Width="140"/><ColumnDefinition Width="320"/></Grid.ColumnDefinitions>
                            <TextBlock Text="Google API-ключ:" VerticalAlignment="Center" FontWeight="Bold"/>
                            <TextBox x:Name="tbOcGoogleKey" Grid.Column="1" Margin="5"/>
                        </Grid>
                        <TextBlock Grid.Row="3" Margin="0,12,0,0" TextWrapping="Wrap" FontSize="11" Foreground="#555"
                                   Text="Хранится в %USERPROFILE%\.ais-secrets\opencode (вне репозитория). Записывается без BOM. После сохранения перезапустите OpenCode."/>
                    </Grid>
                </TabItem>
            </TabControl>
            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="10,5">
                <Button x:Name="btnCheck" Content="Проверить" Click="BtnCheck_Click" Width="120" Height="32" Margin="5,0" FontWeight="Bold" Cursor="Hand" Foreground="White">
                    <Button.Template><ControlTemplate TargetType="Button"><Border CornerRadius="8" Background="#1A3A60" Padding="10,4"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border></ControlTemplate></Button.Template>
                </Button>
                <Button x:Name="btnSave" Content="Сохранить" Click="BtnSave_Click" Width="130" Height="32" Margin="5,0" FontWeight="Bold" Cursor="Hand" Foreground="White">
                    <Button.Template><ControlTemplate TargetType="Button"><Border CornerRadius="8" Background="#2E7D32" Padding="10,4"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border></ControlTemplate></Button.Template>
                </Button>
                <Button x:Name="btnCancel" Content="Отмена" Click="BtnClose_Click" Width="100" Height="32" FontWeight="Bold" Cursor="Hand" Foreground="White">
                    <Button.Template><ControlTemplate TargetType="Button"><Border CornerRadius="8" Background="#666" Padding="10,4"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border></ControlTemplate></Button.Template>
                </Button>
            </StackPanel>
        </Grid>
    </Border>
</Window>
