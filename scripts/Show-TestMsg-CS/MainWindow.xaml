<Window x:Class="Show_TestMsg.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="MSG Тест дизайна" Height="580" Width="520"
        WindowStartupLocation="CenterScreen" Topmost="True"
        ResizeMode="CanResizeWithGrip" Background="#E8ECF0"
        AllowsTransparency="True" WindowStyle="None"
        Loaded="Window_Loaded" SizeChanged="Window_SizeChanged">
    <Window.Resources>
        <Style TargetType="Button" x:Key="Glossy3DButton">
            <Setter Property="Width" Value="120"/><Setter Property="Height" Value="38"/>
            <Setter Property="FontWeight" Value="Bold"/><Setter Property="FontSize" Value="11"/>
            <Setter Property="Margin" Value="4,0"/><Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <Border CornerRadius="10" Background="#CC0F3050">
                                <Grid>
                                    <Border CornerRadius="9" Margin="1.5">
                                        <Border.Background>
                                            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                                <GradientStop Color="#CC9DC8F0" Offset="0"/>
                                                <GradientStop Color="#CC3B7BBF" Offset="0.5"/>
                                                <GradientStop Color="#CC1A4A7A" Offset="1"/>
                                            </LinearGradientBrush>
                                        </Border.Background>
                                    </Border>
                                    <Border CornerRadius="9" Margin="2,2,2,20" Height="7" VerticalAlignment="Top">
                                        <Border.Background>
                                            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                                <GradientStop Color="#E0FFFFFF" Offset="0"/>
                                                <GradientStop Color="#00FFFFFF" Offset="1"/>
                                            </LinearGradientBrush>
                                        </Border.Background>
                                    </Border>
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,2,0,0" TextBlock.FontWeight="Bold" TextBlock.FontSize="11"/>
                                </Grid>
                            </Border>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="Button" x:Key="Glossy3DButtonCancel" BasedOn="{StaticResource Glossy3DButton}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <Border CornerRadius="10" Background="#CC404040">
                                <Grid>
                                    <Border CornerRadius="9" Margin="1.5">
                                        <Border.Background>
                                            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                                <GradientStop Color="#CCD0D0D0" Offset="0"/>
                                                <GradientStop Color="#CC909090" Offset="0.5"/>
                                                <GradientStop Color="#CC606060" Offset="1"/>
                                            </LinearGradientBrush>
                                        </Border.Background>
                                    </Border>
                                    <Border CornerRadius="9" Margin="2,2,2,20" Height="7" VerticalAlignment="Top">
                                        <Border.Background>
                                            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                                <GradientStop Color="#E0FFFFFF" Offset="0"/>
                                                <GradientStop Color="#00FFFFFF" Offset="1"/>
                                            </LinearGradientBrush>
                                        </Border.Background>
                                    </Border>
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,2,0,0" TextBlock.FontWeight="Bold" TextBlock.FontSize="11"/>
                                </Grid>
                            </Border>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="ProgressBar" x:Key="GlossyProgress">
            <Setter Property="Height" Value="18"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ProgressBar">
                        <Grid>
                            <Border CornerRadius="4" Background="#CC0F3050" Padding="1.5">
                                <Border CornerRadius="3" Background="#E2E8F0">
                                    <Grid ClipToBounds="True">
                                        <Grid x:Name="PART_Track">
                                            <Border x:Name="PART_Indicator" CornerRadius="3" BorderBrush="#CC1A3A60" BorderThickness="0,0,1,0" HorizontalAlignment="Left">
                                                <Border.Background>
                                                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                                        <GradientStop Color="#CCB8D8F8" Offset="0"/>
                                                        <GradientStop Color="#CC3B7BBF" Offset="0.4"/>
                                                        <GradientStop Color="#CC1A4A7A" Offset="0.8"/>
                                                        <GradientStop Color="#CC0F3050" Offset="1"/>
                                                    </LinearGradientBrush>
                                                </Border.Background>
                                            </Border>
                                        </Grid>
                                        <Border CornerRadius="3" Margin="1,1,1,9" Height="5" VerticalAlignment="Top">
                                            <Border.Background>
                                                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                                    <GradientStop Color="#C0FFFFFF" Offset="0"/>
                                                    <GradientStop Color="#00FFFFFF" Offset="1"/>
                                                </LinearGradientBrush>
                                            </Border.Background>
                                        </Border>
                                        <Border CornerRadius="3" Margin="1,12,1,1" Height="3" VerticalAlignment="Bottom" IsHitTestVisible="False">
                                            <Border.Background>
                                                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                                    <GradientStop Color="#30000000" Offset="0"/>
                                                    <GradientStop Color="#80000000" Offset="1"/>
                                                </LinearGradientBrush>
                                            </Border.Background>
                                        </Border>
                                    </Grid>
                                </Border>
                            </Border>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <Border CornerRadius="18" Background="#E8ECF0" BorderBrush="#1A3A60" BorderThickness="1">
        <Border.Effect><DropShadowEffect Color="#404040" Direction="270" ShadowDepth="4" BlurRadius="10" Opacity="0.5"/></Border.Effect>
        <Grid>
            <Grid.RowDefinitions><RowDefinition Height="40"/><RowDefinition Height="*"/></Grid.RowDefinitions>
            <Border Grid.Row="0" Background="#807080B0" CornerRadius="17,17,0,0" BorderBrush="#1A3A60" BorderThickness="0,0,0,1" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <Grid Grid.Column="0" Margin="14,0,0,0" VerticalAlignment="Center" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                        <TextBlock Text="MSG Тест дизайна" Foreground="White" FontWeight="Bold" FontSize="14" FontFamily="Segoe UI" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="3,2,0,0" Opacity="0.9"/>
                        <TextBlock Text="MSG Тест дизайна" Foreground="#1A3A60" FontWeight="Bold" FontSize="14" FontFamily="Segoe UI" HorizontalAlignment="Left" VerticalAlignment="Center"/>
                    </Grid>
                    <Button Grid.Column="1" Content="━" Click="BtnMinimize_Click" Width="40" Height="36" Background="Transparent" Foreground="#1A3A60" BorderThickness="0" FontSize="14" FontWeight="Bold" Cursor="Hand"/>
                    <Button Grid.Column="2" Content="☐" Click="BtnMaximize_Click" Width="40" Height="36" Background="Transparent" Foreground="#1A3A60" BorderThickness="0" FontSize="14" FontWeight="Bold" Cursor="Hand"/>
                    <Button Grid.Column="3" Content="✕" Click="BtnClose_Click" Width="40" Height="36" Background="Transparent" Foreground="#1A3A60" BorderThickness="0" FontSize="14" FontWeight="Bold" Cursor="Hand"/>
                </Grid>
            </Border>
            <Grid Grid.Row="1" Margin="10,6,10,10">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Border Grid.Row="0" Background="#EBF4FF" CornerRadius="8" BorderBrush="#CBD5E0" BorderThickness="1" Padding="8" Margin="0,0,0,8">
                    <TextBlock Text="Это тестовое окно для проверки оформления MSG-диалогов в стиле APPL. Овальные кнопки, закруглённые углы, серая градация фона." TextWrapping="Wrap" FontSize="9" Foreground="#4A5568"/>
                </Border>
                <Grid Grid.Row="1" Margin="0,0,0,8">
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Text="Текстовое поле (TextBox)" FontSize="9" Foreground="#4A5568" Margin="0,0,0,2"/>
                    <Border CornerRadius="10" BorderBrush="#CBD5E0" BorderThickness="1" Margin="0,0,0,4">
                        <TextBox Grid.Row="1" x:Name="txtField" Height="24" FontSize="10" BorderThickness="0" Padding="6,2"/>
                    </Border>
                    <TextBlock Grid.Row="2" Text="Поле пароля (PasswordBox)   Выпадающий список (ComboBox)" FontSize="9" Foreground="#A0AEC0" Margin="0,0,0,2"/>
                </Grid>
                <Grid Grid.Row="2" Margin="0,0,0,8">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="10"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <Grid Grid.Column="0">
                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Text="Поле пароля" FontSize="9" Foreground="#4A5568" Margin="0,0,0,2"/>
                        <Border CornerRadius="10" BorderBrush="#CBD5E0" BorderThickness="1">
                            <PasswordBox Grid.Row="1" x:Name="pwdField" Height="24" FontSize="10" BorderThickness="0" Padding="6,2"/>
                        </Border>
                    </Grid>
                    <Grid Grid.Column="2">
                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Text="Выпадающий список" FontSize="9" Foreground="#4A5568" Margin="0,0,0,2"/>
                        <ComboBox Grid.Row="1" x:Name="cmbField" Height="24" FontSize="10" BorderBrush="#CBD5E0" BorderThickness="1"/>
                    </Grid>
                </Grid>
                <TextBlock Grid.Row="3" x:Name="lblPhase" Text="Фаза 1: инициализация" FontSize="9" Foreground="#4A5568" Margin="0,0,0,2"/>
                <Grid Grid.Row="4" Margin="0,0,0,4">
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="4"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <ProgressBar Grid.Row="0" x:Name="pb1" Style="{StaticResource GlossyProgress}"/>
                    <Grid Grid.Row="2"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <ProgressBar Grid.Column="0" x:Name="pb2" Style="{StaticResource GlossyProgress}"/>
                        <TextBlock Grid.Column="1" x:Name="lblCounter" Text="(0 из 5)" FontSize="8" Foreground="#A0AEC0" VerticalAlignment="Center" Margin="6,0,0,0"/>
                    </Grid>
                </Grid>
                <StackPanel Grid.Row="6" Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button x:Name="btnOk" Content="OK" Click="BtnOk_Click" Style="{StaticResource Glossy3DButton}" IsDefault="True"/>
                    <Button x:Name="btnCancel" Content="Отмена" Click="BtnCancel_Click" Style="{StaticResource Glossy3DButtonCancel}"/>
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</Window>