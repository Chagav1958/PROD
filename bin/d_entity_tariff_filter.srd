 retrieve="  SELECT convert(numeric(10, 0), -1) as our_subj_id,
			 convert(numeric(10, 0), -1) as division_id, 
		     convert(varchar(8), '%') as state,
			 convert(varchar(64), '%') as recep_name,
			 convert(varchar(16), '%') as entity_type,
			 convert(datetime, convert(varchar(4), DatePart(yy, getdate())) + '-01-01') as date_from,
			 convert(datetime, getdate()) as date_to,

			convert(char(3), '%') as system,
			convert(numeric(10, 0), -1) as product_id,
			convert(int, -1) as special,

		     convert(int, 1) as state_all,
		     convert(int, 0) as state_n,
		     convert(int, 0)  as state_a,
		     convert(int, 0)  as state_x,
		     convert(int, 0)  as state_c 


" )
